# Public canonical URL (used for canonical tags, sitemap, JSON-LD)
PUBLIC_SITE_URL=https://mdimamhosen.netlify.app

# MongoDB (server only)
MONGODB_URI=
MONGODB_DB=portfolio
MONGODB_VISITORS_COLLECTION=visitors

# Admin login for /login, /admin*, /admin/blog
# Generate the hash with: BLOG_ADMIN_PASSWORD=... node scripts/hash-admin-password.mjs
BLOG_ADMIN_PASSWORD_HASH=
# Long random string, e.g. `openssl rand -hex 32`
BLOG_SESSION_SECRET=

# AI chat (server only)
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_COHOST_AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Visitor tracking. TRACKING key is also sent from the browser, so it is not a secret;
# VISITOR_API_KEY is only for scripts reading /api/visitors (the dashboard uses the admin session).
TRACKING_API_KEY=
NEXT_PUBLIC_TRACKING_API_KEY=
VISITOR_API_KEY=

# Share page cloud backup limit in bytes (default 50 MB)
SHARE_CLOUD_MAX_BYTES=52428800

# Browser (public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Only for the one-time migration script (npm run migrate:blog)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
